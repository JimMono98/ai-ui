{
  "name": "@jimmono98/ai-ui",
  "version": "0.1.0",
  "description": "Cross-platform AI design system and UI component library for React Native, Expo and Web",
  "main": "./dist/index.js",
  "scripts": {
    "clean:dist": "rm -rf dist",
    "clean": "rm -rf dist storybook-static coverage playwright-report test-results",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean:dist && tsc -p tsconfig.build.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "verify": "npm run typecheck && npm run build && npm run build-storybook",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JimMono98/ai-ui.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/JimMono98/ai-ui/issues"
  },
  "homepage": "https://github.com/JimMono98/ai-ui#readme",
  "types": "./dist/index.d.ts",
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-native-web-vite": "^10.6.0",
    "@types/react": "^19.3.0",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "playwright": "latest",
    "react": "^19.3.0",
    "react-native": "^0.87.1",
    "react-native-svg": "^15.15.5",
    "react-native-web": "latest",
    "storybook": "^10.6.0",
    "typescript": "^7.0.2",
    "vite": "latest",
    "vitest": "latest"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.76.0",
    "react-native-svg": ">=15.0.0",
    "react-native-web": ">=0.19.0"
  },
  "module": "./dist/index.js",
  "react-native": "./dist/index.js",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependenciesMeta": {
    "react-native-web": {
      "optional": true
    }
  }
}
